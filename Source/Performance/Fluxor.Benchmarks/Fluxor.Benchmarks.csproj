<Project Sdk="Microsoft.NET.Sdk">

	<!-- Run on demand, not in CI (see StartupBenchmarks) -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	</ItemGroup>

	<!-- Both samples declare the same types, so the benchmarks load them by assembly name -->
	<ItemGroup>
		<ProjectReference Include="..\..\Lib\Fluxor\Fluxor.csproj" />
		<ProjectReference Include="..\Fluxor.Performance.Sample.Generated\Fluxor.Performance.Sample.Generated.csproj" />
		<ProjectReference Include="..\Fluxor.Performance.Sample.Scanned\Fluxor.Performance.Sample.Scanned.csproj" />
	</ItemGroup>

</Project>
